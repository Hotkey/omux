<Window x:Class="Omux.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Project" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource ForegroundBrush}">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,12,0" />
    <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,4" />

    <TextBlock Grid.Row="1" Text="Folder" VerticalAlignment="Center" Margin="0,0,12,0" />
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
      <Button DockPanel.Dock="Right" Content="Choose…" Click="Choose_Click" Margin="8,0,0,0" />
      <Grid>
        <TextBox x:Name="FolderBox" />
        <TextBlock x:Name="FolderPrompt" Text="~" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TertiaryBrush}" />
      </Grid>
    </DockPanel>

    <TextBlock Grid.Row="2" Text="Command for new sessions" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
      <TextBox x:Name="CommandBox" />
      <TextBlock x:Name="CommandPrompt" Text="leave empty for a plain shell" IsHitTestVisible="False" Margin="12,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}" />
    </Grid>

    <TextBlock Grid.Row="3" Grid.Column="1" Text="Applies when a session starts. Existing sessions keep running."
               Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />

    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
      <Button Content="Save" IsDefault="True" MinWidth="80" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
  </Grid>
</Window>
