<Window x:Class="Omux.RecentSessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="440" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ChromeBrush}"
        Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource SelectionBrush}" BorderThickness="1">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
        <ToggleButton x:Name="RecentMode" Content="Recent" Click="RecentMode_Click" Padding="10,2" IsChecked="True" Focusable="False" />
        <ToggleButton x:Name="FolderMode" Content="By folder" Click="FolderMode_Click" Padding="10,2" Focusable="False" />
      </StackPanel>
      <TextBox x:Name="Query" Style="{StaticResource SheetSearch}" Tag="Search recent Claude sessions…"
               TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />
    </DockPanel>
    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SeparatorBrush}" />
    <Grid>
      <TextBlock x:Name="Message" Text="Loading…" Style="{StaticResource Caption}" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox x:Name="Results" ItemContainerStyle="{StaticResource SheetRow}" Background="Transparent" BorderThickness="0"
               Padding="0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="Results_MouseLeftButtonUp"
               VirtualizingPanel.IsVirtualizingWhenGrouping="True">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TertiaryBrush}" Margin="16,10,16,4" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="open" Style="{StaticResource Caption}" FontSize="10" Margin="8,0,0,0"
                           Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Session.Prompt}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <DockPanel Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Session.Folder}" Style="{StaticResource Caption}"
                           Visibility="{Binding ShowFolder, Converter={StaticResource Visible}}" />
              </DockPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</Window>
