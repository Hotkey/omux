<UserControl x:Class="Omux.FilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Omux"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource ChromeBrush}" AllowDrop="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="200" />
      <RowDefinition x:Name="SplitterRow" Height="5" />
      <RowDefinition x:Name="BrowserRow" Height="180" MinHeight="80" />
    </Grid.RowDefinitions>

    <!-- Preview -->
    <DockPanel Background="{DynamicResource BackgroundBrush}">
      <Border DockPanel.Dock="Top" Height="28" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource ChromeBrush}" x:Name="PreviewHeader" Visibility="Collapsed">
        <DockPanel Margin="10,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8B7;" Click="Reveal_Click" ToolTip="Show in Explorer" />
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="OpenWith_Click" ToolTip="Open with default app" Margin="4,0" />
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE751;" Click="Wrap_Click" x:Name="WrapButton" />
          <TextBlock x:Name="PreviewName" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PreviewSize" Style="{StaticResource Caption}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <Grid>
        <wv2:WebView2 x:Name="PreviewWeb" Visibility="Collapsed" DefaultBackgroundColor="Transparent" />
        <TextBlock x:Name="PreviewPlaceholder" Text="Select a file to preview" Style="{StaticResource Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Row="1" Style="{StaticResource Divider}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

    <!-- Browser -->
    <DockPanel Grid.Row="2">
      <Border DockPanel.Dock="Top" Height="28" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
        <DockPanel Margin="6,0,10,0">
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" FontSize="8" x:Name="CollapseButton" Click="Collapse_Click"
                  Content="&#xE76C;" RenderTransformOrigin="0.5,0.5" />
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="OpenRoot_Click" ToolTip="Open folder in Explorer" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="SortPicker" Margin="0,0,6,0" VerticalAlignment="Center">
            <ToggleButton x:Name="SortName" Content="Name" Click="SortName_Click" FontSize="10" Padding="8,1" MinHeight="0" MinWidth="0" />
            <ToggleButton x:Name="SortDate" Content="Date" Click="SortDate_Click" FontSize="10" Padding="8,1" MinHeight="0" MinWidth="0" />
          </StackPanel>
          <TextBlock x:Name="RootName" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"
                     Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
      <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" SelectedItemChanged="Tree_SelectedItemChanged"
                VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <EventSetter Event="MouseRightButtonUp" Handler="Node_MouseRightButtonUp" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.Resources>
          <HierarchicalDataTemplate DataType="{x:Type local:FileNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
              <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                     Visibility="{Binding Icon, Converter={StaticResource NotNull}}" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSection}" Value="True">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Subtitle}" Margin="4,0,0,0" FontSize="11" Foreground="{DynamicResource TertiaryBrush}"
                         VerticalAlignment="Center" Visibility="{Binding Subtitle, Converter={StaticResource NotNull}}" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.Resources>
      </TreeView>
    </DockPanel>
  </Grid>
</UserControl>
