<UserControl x:Class="Omux.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Omux">
  <UserControl.Resources>
    <!-- Shown only while the pointer is over the row. -->
    <Style x:Key="OnHover" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="OffHover" TargetType="FrameworkElement">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="RenameBox" TargetType="TextBox">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>

    <!-- Project header row. -->
    <DataTemplate DataType="{x:Type local:TabGroup}">
      <Grid Margin="4,8,2,1" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TertiaryBrush}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Visibility="{Binding IsRenaming, Converter={StaticResource Hidden}}" />
        <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource RenameBox}" FontSize="11"
                 Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                 IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus" />
        <!-- Show/hide chevron on hover, then the + at the trailing edge. -->
        <Button Grid.Column="1" FontSize="8" Click="Collapse_Click" Padding="3"
                Foreground="{DynamicResource TertiaryBrush}" RenderTransformOrigin="0.5,0.5">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
              <Setter Property="Content" Value="&#xE76C;" />
              <Setter Property="ToolTip" Value="Hide sessions" />
              <Setter Property="Opacity" Value="0" />
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="90" />
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="ToolTip" Value="Show sessions" />
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <RotateTransform Angle="0" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="9" Padding="3"
                Foreground="{DynamicResource TertiaryBrush}" Click="GroupNewTab_Click" ToolTip="{Binding Name}"
                ToolTipService.InitialShowDelay="600" />
      </Grid>
    </DataTemplate>

    <!-- Session row. -->
    <DataTemplate DataType="{x:Type local:TabItem}">
      <Grid Margin="10,4,4,4">
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Runtime.Exited}" Value="True" />
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Opacity" Value="0.55" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Top-aligned so the dot stays beside the name when agent rows or buttons follow. -->
        <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Top" Margin="0,6,8,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding IsRenaming, Converter={StaticResource Hidden}}" />
          <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource RenameBox}"
                   Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                   IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus" />
          <DockPanel Margin="0,1,0,0" Visibility="{Binding SidebarLine, Converter={StaticResource NotNull}}">
            <TextBlock Text="&#x2442;" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,-1,4,0"
                       Foreground="{DynamicResource SecondaryBrush}" Visibility="{Binding Worktree, Converter={StaticResource NotNull}}" />
            <!-- ● #42 after the branch: the pull request and its state. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0"
                        Visibility="{Binding Runtime.PullRequest, Converter={StaticResource NotNull}}"
                        ToolTip="{Binding Runtime.PullRequest.Summary}">
              <Ellipse Width="5" Height="5" Fill="{Binding Runtime.PullRequest.Brush}" VerticalAlignment="Center" Margin="0,0,3,0" />
              <TextBlock Text="{Binding Runtime.PullRequest.Number, StringFormat='#{0}'}" Style="{StaticResource Caption}" />
            </StackPanel>
            <TextBlock Text="{Binding SidebarLine}" Style="{StaticResource Caption}" />
          </DockPanel>
          <local:PermissionButtons TabId="{Binding Id}" HorizontalAlignment="Left" Margin="0,4,0,1"
                                   Visibility="{Binding Runtime.AwaitsPermission, Converter={StaticResource Visible}}" />
          <Button Content="Delete Worktree" HorizontalAlignment="Left" Margin="0,4,0,1" FontSize="11" Padding="10,1,10,2" MinHeight="0"
                  Focusable="False" Click="DeleteWorktree_Click"
                  ToolTip="The pull request was merged. Close this session and delete its worktree and branch."
                  Visibility="{Binding Runtime.PullRequest.IsMerged, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
          <!-- Every subagent of the selected session, and those that need you in any session. -->
          <ItemsControl ItemsSource="{Binding SidebarAgents}" Margin="0,3,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:SubAgent}">
                <!-- Mouse up rather than a Button's click: the row also selects its session, and the transcript shows for the selected one. -->
                <Border MouseLeftButtonUp="Agent_Click" ToolTip="{Binding Tooltip}" Cursor="Hand" CornerRadius="4" Padding="4,1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel Margin="{Binding Indent}" TextElement.FontSize="11">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShortActivity}" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Blocked}" Value="True">
                              <Setter Property="Foreground" Value="#FF9F0A" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Ellipse Width="7" Height="7" Stroke="{Binding Brush}" Fill="{Binding DotFill}" StrokeThickness="1.5"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Grid Grid.Column="2" VerticalAlignment="Top" Margin="4,2,0,0">
          <StackPanel Orientation="Horizontal" Style="{StaticResource OnHover}">
            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" FontSize="10" Click="Stop_Click" ToolTip="Interrupt (Ctrl-C)"
                    Visibility="{Binding Runtime.Busy, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="10" Click="Start_Click" ToolTip="Continue this Claude conversation"
                    Visibility="{Binding Runtime.Busy, Converter={StaticResource Hidden}}" />
          </StackPanel>
          <Grid Style="{StaticResource OffHover}">
            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FF9F0A"
                       Visibility="{Binding Runtime.NeedsAttention, Converter={StaticResource Visible}}" />
            <Ellipse Width="6" Height="6" Fill="#0A84FF">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Runtime.HasActivity}" Value="True" />
                        <Condition Binding="{Binding Runtime.NeedsAttention}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
          </Grid>
        </Grid>
      </Grid>
    </DataTemplate>

    <Style x:Key="Row" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <EventSetter Event="MouseEnter" Handler="Row_MouseEnter" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown" />
      <EventSetter Event="MouseRightButtonUp" Handler="Row_MouseRightButtonUp" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="5" Margin="6,0">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <DockPanel Background="{DynamicResource ChromeBrush}">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Height="28" Margin="0,0,8,0">
      <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="NewTab_Click" ToolTip="New session in current project (Ctrl+Shift+T)" Margin="3,0" />
      <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" Click="OpenFolder_Click" ToolTip="Open folder as a project (Ctrl+Shift+O)" Margin="3,0" />
      <Button Style="{StaticResource IconButton}" Content="&#xE81C;" Click="Recent_Click" ToolTip="Open recent Claude session (Ctrl+Shift+Alt+O)" Margin="3,0" />
      <Button Style="{StaticResource IconButton}" Content="&#xE712;" Click="More_Click" ToolTip="All commands" Margin="3,0" />
      <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings (Ctrl+,)" Margin="3,0" />
    </StackPanel>

    <!-- One compact line of Claude limits: 5h 1%  Week 32%, each with a hairline bar. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" x:Name="Usage">
      <Grid Margin="12,6">
        <TextBlock Text="{Binding Placeholder}" Style="{StaticResource Caption}" FontSize="10"
                   Visibility="{Binding Placeholder, Converter={StaticResource NotNull}}" />
        <ItemsControl ItemsSource="{Binding Limits}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,10,0" Background="Transparent" ToolTip="{Binding ResetText}"
                          MouseEnter="Limit_MouseEnter" MouseLeave="Limit_MouseLeave">
                <TextBlock Text="{Binding Text}" FontSize="10">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Hovered}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Grid Height="3" Margin="0,2,0,0">
                  <Border CornerRadius="1.5" Background="{DynamicResource SelectionBrush}" />
                  <Border CornerRadius="1.5" Background="{Binding Tint}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleX="{Binding Fraction}" />
                    </Border.RenderTransform>
                  </Border>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <ListBox x:Name="List" ItemsSource="{Binding Rows, Source={x:Static local:Store.Shared}}"
             ItemContainerStyle="{StaticResource Row}" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" AllowDrop="True"
             SelectionChanged="List_SelectionChanged" PreviewMouseMove="List_PreviewMouseMove"
             DragOver="List_DragOver" Drop="List_Drop" MouseRightButtonUp="List_MouseRightButtonUp" />
  </DockPanel>
</UserControl>
