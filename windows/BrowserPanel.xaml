<UserControl x:Class="Omux.BrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,0">
        <Button DockPanel.Dock="Left" x:Name="Back" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="Back" />
        <Button DockPanel.Dock="Left" x:Name="Forward" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="Forward_Click" ToolTip="Forward" Margin="2,0" />
        <Button DockPanel.Dock="Left" x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Reload_Click" ToolTip="Reload" />
        <Button DockPanel.Dock="Right" x:Name="External" Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="External_Click"
                ToolTip="Open in default browser" />
        <Button DockPanel.Dock="Right" x:Name="Pick" Style="{StaticResource IconButton}" Content="&#xE8B0;" Click="Pick_Click"
                ToolTip="Pick an element to send to Claude" Margin="2,0" />
        <Grid Margin="6,0">
          <TextBox x:Name="Address" FontSize="12" MinHeight="0" Padding="8,3" KeyDown="Address_KeyDown" VerticalAlignment="Center" />
          <TextBlock x:Name="AddressPrompt" Text="localhost:3000" IsHitTestVisible="False" Margin="10,0" FontSize="12"
                     VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}" />
        </Grid>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" x:Name="PickBanner" Padding="10,5" Background="#1A3B8EEA" Visibility="Collapsed">
      <TextBlock Text="Click an element to send it to Claude. Esc cancels." FontSize="11" Foreground="{DynamicResource AccentBrush}" />
    </Border>

    <Border DockPanel.Dock="Bottom" x:Name="NoticeBar" Height="30" Padding="10,0" Background="{DynamicResource ChromeBrush}" Visibility="Collapsed">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Click="DismissNotice_Click" />
        <TextBlock x:Name="Notice" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <!-- One web view per session; only the selected session's is visible. -->
      <Grid x:Name="WebHost" />

      <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TertiaryBrush}" />
        <TextBlock Text="No page open" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
        <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="260" />
        <ItemsControl x:Name="Servers" HorizontalAlignment="Center" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Center" Margin="0,2" FontSize="12">
                <Hyperlink Click="Server_Click" Foreground="{DynamicResource AccentBrush}"><Run Text="{Binding Mode=OneWay}" /></Hyperlink>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel x:Name="Failure" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Visibility="Collapsed">
        <TextBlock Text="Couldn't load the page" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="FailureDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"
                   MaxWidth="280" Margin="0,6,0,10" />
        <Button Content="Try Again" Click="Reload_Click" HorizontalAlignment="Center" FontSize="12" Padding="10,3" MinHeight="0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
